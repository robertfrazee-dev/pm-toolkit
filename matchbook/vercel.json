{
  "rewrites": [
    {
      "source": "/j/:code",
      "destination": "/index.html"
    },
    {
      "source": "/b/:id",
      "destination": "/index.html"
    },
    {
      "source": "/.well-known/apple-app-site-association",
      "destination": "/api/aasa"
    }
  ],
  "crons": [
    {
      "path": "/api/market?op=cron",
      "schedule": "0 10 * * *"
    }
  ]
}
